# Self-hosting defaults for `docker compose up`. Copy to .env and change what you need:
#   cp .env.example .env
# Everything here is optional; compose falls back to the same values.

# The address the site is served on, with TLS from Caddy. Use your domain to get a public certificate.
SITE_ADDRESS=localhost

# The public origin the pages and e-mails link to. Must match how people reach the site.
APP_ORIGIN=https://localhost

# Shared secret the web app sends to the api (x-internal-token). Change it: anyone holding it can
# act as any user on the api's private network.
API_INTERNAL_TOKEN=change-me

# Bearer token that makes /healthz show each app's version and revision. Unset: it shows only
# status and database.
# HEALTHZ_TOKEN=

# Host ports. The database is bound to 127.0.0.1 only.
DB_PORT=5432
MAILPIT_PORT=8025

# Supabase Auth and Storage run in the stack. These defaults are Supabase's public demo keys, so
# anyone could sign a token with them: generate your own before others can reach the site, with
#   docker run --rm -v "$PWD":/app -w /app oven/bun:1.4 bun scripts/self-host-keys.ts >> .env
# SUPABASE_JWT_SECRET=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=

# On by default: the web app, api and worker refuse to start pointed at an outside service, and any
# request they make to a public address fails. Set to false to connect Resend, Sentry, GrowthBook,
# Mixpanel or Instagram (pass their settings to the services; see .dev.vars.example for the names).
LOCAL_ONLY=true
