{
  "format": ["node_modules/.bin/prettier", "--write", "--ignore-unknown", "{file}"],
  "check": [
    {
      "name": "Prettier",
      "run": ["node_modules/.bin/prettier", "--check", "--ignore-unknown", "{files}"]
    },
    {
      "name": "ESLint",
      "match": "\\.(ts|js|svelte)$",
      "run": ["node_modules/.bin/eslint", "--no-warn-ignored", "{files}"]
    },
    {
      "name": "Typecheck",
      "match": "\\.(ts|js|svelte)$",
      "run": ["bun", "run", "check"]
    }
  ],
  "guard": {
    "deny": [
      {
        "pattern": "\\bwrangler\\s+(deploy|versions\\s+(deploy|upload)|rollback)\\b",
        "unless": "--dry-run\\b",
        "reason": "Production deploys come only from the pinned release in mesaaberta-infra. Use `wrangler deploy --dry-run` to bundle."
      }
    ],
    "ask": [
      {
        "pattern": "\\bwrangler\\s+(queues|kv|d1|r2|hyperdrive|vectorize|pipelines|secret|secrets-store)\\b.*\\b(create|delete|put|bulk|update)\\b",
        "reason": "This creates or changes a Cloudflare resource. The project rule is to tell the user first."
      }
    ]
  }
}
