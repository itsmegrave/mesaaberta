# One address for Supabase Auth and Storage on the Docker network, laid out like a Supabase project
# (`/auth/v1`, `/storage/v1`), which is what supabase-js expects. Only the web app, the api and the
# worker reach it; the public proxy forwards just the e-mail links and the public images.
:8000 {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /storage/v1/* {
		reverse_proxy storage:5000
	}
	handle {
		respond 404
	}
}
