# Copy to .dev.vars (git-ignored). Read by `vite dev`, `wrangler dev` and the db:* scripts.
DATABASE_URL=postgres://mesaaberta:mesaaberta@localhost:5432/mesaaberta

# Safety default for local development: transactional e-mail goes to the local Supabase Mailpit.
# Remove this only for a deliberate, manual Resend smoke test.
MAILPIT_URL=http://127.0.0.1:54344

# Set to true only while developing locally to return true for every feature flag. It only applies
# to requests for localhost or 127.0.0.1, so it does nothing on preview or production hosts.
# IGNORE_FEATURE_FLAGS_IN_LOCALHOST=true

# Fixed flag values, which win over GrowthBook and the defaults (localhost only). The preview mode above
# never turns the maintenance_mode kill switch on; this does.
# FEATURE_FLAG_OVERRIDES=maintenance_mode=true

# Supabase Auth. Blank in wrangler.jsonc, so login is off locally until these are set. For the
# local stack, run `bun run e2e:up` and copy API_URL and PUBLISHABLE_KEY from
# `bun run supabase status`. Both are public values, not secrets.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where browsers load stored images, when the server reaches Supabase at an address they cannot
# (the Docker stack sets it to the site's origin). Unset: SUPABASE_URL.
# SUPABASE_PUBLIC_URL=
# true: refuse to start pointed at an outside service, and refuse any request to a public address.
# LOCAL_ONLY=

# Feature flags. Blank in wrangler.jsonc, so every flag returns its registry default. Set a
# GrowthBook client key (read-only, not a secret) to load live values.
# GROWTHBOOK_CLIENT_KEY=sdk-...

# Calendar invite e-mail (Trello #13). Keep these secrets out of wrangler.jsonc and set them with
# `wrangler secret put` in production. The handler is disabled until the first four are present.
# RESEND_API_KEY=re_...
# RESEND_FROM=Mesa Aberta <no-reply@mesaaberta.app>
# A Supabase secret key (Project Settings > API Keys), not the legacy service_role key.
# SUPABASE_SECRET_KEY=sb_secret_...
# APP_ORIGIN=https://mesaaberta.app

# Hosted Resend templates (optional, see "Hosted e-mail templates" in the README). Template ids or
# aliases, not secrets. A blank or missing one keeps that e-mail on its inline text.
# RESEND_TEMPLATE_INVITE=
# RESEND_TEMPLATE_CANCEL=
# RESEND_TEMPLATE_JOIN_REQUESTED=
# RESEND_TEMPLATE_PLAYER_INVITATION=
# RESEND_TEMPLATE_JOIN_DECLINED=
# RESEND_TEMPLATE_ACCOUNT_BANNED=

# Product analytics, server-side only. Set these only for deliberate analytics smoke tests locally.
# MIXPANEL_TOKEN=
# MIXPANEL_REGION=US
