# Copy to .dev.vars (git-ignored). Read by `vite dev`, `wrangler dev` and the db:* scripts.
DATABASE_URL=postgres://mesaaberta:mesaaberta@localhost:5432/mesaaberta

# Supabase Auth. The project URL and publishable key are in wrangler.jsonc (public by design), so
# login works locally without anything here. Set these only to point at another Supabase project;
# they override wrangler.jsonc.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Calendar invite e-mail (Trello #13). Keep these secrets out of wrangler.jsonc and set them with
# `wrangler secret put` in production. The handler is disabled until all four are present.
# RESEND_API_KEY=re_...
# RESEND_FROM=Mesa Aberta <convites@mesaaberta.app>
# SUPABASE_SERVICE_ROLE_KEY=...
# APP_ORIGIN=https://mesaaberta.app
