{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mesaaberta",
	"compatibility_date": "2026-09-19",
	// `nodejs_compat` (which includes `nodejs_als`) is what postgres.js needs to run in a Worker.
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Public by design: the GrowthBook client key only allows reading feature flags.
	"vars": {
		"GROWTHBOOK_API_HOST": "https://cdn.growthbook.io",
		"GROWTHBOOK_CLIENT_KEY": "sdk-aG2334gmGT5wnD4o"
	},
	// Add once, after creating the Hyperdrive config (see "Database" in the README):
	//   "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<id from `wrangler hyperdrive create`>" }],
	// Without it the Worker runs with no database and /healthz reports `not_configured`.
	// Retries domain events that did not finish (see src/lib/server/events). Without a database it does nothing.
	// `pnpm build` adds the `scheduled` handler the adapter does not export (scripts/wrap-worker.ts).
	"triggers": { "crons": ["*/5 * * * *"] },
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	}
}
