{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mesaaberta",
  "compatibility_date": "2026-09-19",
  // `nodejs_compat` (which includes `nodejs_als`) is what postgres.js needs to run in a Worker.
  "compatibility_flags": ["nodejs_compat"],
  "main": "apps/web/.svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "apps/web/.svelte-kit/cloudflare",
  },
  // Placeholders, never a deployment's values: this file is what `vite dev`, `wrangler dev`, CI and
  // the e2e tests run on. A deployment keeps its own copy with its own values (ours is private).
  // Every variable a deployment may set is listed, so the names stay documented in one place. None
  // of them is a secret: secrets never go in a Wrangler file. Override any of them locally in
  // `.dev.vars`.
  "vars": {
    // What the pages say about this deployment (see `siteOf`). A blank one takes a placeholder;
    // a blank Instagram handle hides the link.
    "APP_ORIGIN": "",
    "CONTACT_EMAIL": "",
    "PRIVACY_CONTROLLER_NAME": "",
    "PRIVACY_EMAIL": "",
    "INSTAGRAM_HANDLE": "",
    // The namespace of calendar event UIDs. Set it once and never change it after the first invite
    // went out, or calendar apps show a table twice. Blank: the host of APP_ORIGIN.
    "CALENDAR_UID_DOMAIN": "",
    // "true" turns on the daily RPG campaign discovery (04:00 UTC).
    "CROWDFUNDING_IMPORT_ENABLED": "false",
    // Footer links to a feedback board and release notes. Blank hides them.
    "CANNY_CHANGELOG_URL": "",
    "CANNY_FEEDBACK_URL": "",
    // Blank key: every feature flag returns its default from the registry.
    "GROWTHBOOK_API_HOST": "https://cdn.growthbook.io",
    "GROWTHBOOK_CLIENT_KEY": "",
    // Sentry for the web app (server and browser). Blank DSN: nothing is sent. With an origin set
    // (`https://example.org`), only that origin reports, so preview URLs stay quiet.
    "PUBLIC_SENTRY_DSN": "",
    "PUBLIC_SENTRY_ORIGIN": "",
    "RESEND_FROM": "Mesa Aberta <no-reply@example.invalid>",
    // Ids of the hosted Resend templates (see "Hosted e-mail templates" in the README). A blank one
    // keeps that e-mail on its inline text.
    "RESEND_TEMPLATE_ACCOUNT_BANNED": "",
    "RESEND_TEMPLATE_CANCEL": "",
    "RESEND_TEMPLATE_INVITE": "",
    "RESEND_TEMPLATE_JOIN_DECLINED": "",
    "RESEND_TEMPLATE_JOIN_REQUESTED": "",
    // Blank: login is off until a Supabase project is configured (see "Sign-in" in the README).
    "SUPABASE_PUBLISHABLE_KEY": "",
    "SUPABASE_URL": "",
  },
  // The database, through Hyperdrive (see "Database" in the README). The id is a placeholder: use
  // your own Hyperdrive config id when deploying. `localConnectionString` is what `wrangler dev`,
  // `vite dev` and CI use instead: the Postgres from docker-compose.yml (`bun run db:up`).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://mesaaberta:mesaaberta@localhost:5432/mesaaberta",
    },
  ],
  // Empty on purpose: the two crons (event sweep every 5 minutes, daily import at 04:00) run on
  // `mesaaberta-worker` (apps/worker). This Worker is SvelteKit's own output and has no `scheduled`
  // handler, so a cron added here would fail.
  "triggers": { "crons": [] },
  // Shadow stage of the Queues canary (ADR 0003): the producer binding. Nothing is sent until the
  // GrowthBook flag `api_events_queue_shadow` targets someone, and its consumer is `mesaaberta-worker`.
  "queues": { "producers": [{ "binding": "DOMAIN_EVENTS", "queue": "domain-events-canary" }] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    // Detects and groups production failures in the dashboard. Without this, a Wrangler deploy
    // turns Issues off again.
    "issues": { "enabled": true },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
