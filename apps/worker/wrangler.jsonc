{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mesaaberta-worker",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/entry.ts",
  // No public route and no custom domain: this Worker only runs on triggers.
  "workers_dev": false,
  "preview_urls": false,
  // Event sweep every 5 minutes and the daily import at 04:00. They moved here from the web Worker
  // (../../wrangler.jsonc) in one step; two Workers on the same cron would run every job twice.
  "triggers": { "crons": ["*/5 * * * *", "0 4 * * *"] },
  // Placeholders, like the web Worker's (../../wrangler.jsonc): a deployment keeps its own copy with
  // its own values. Secrets (database, Instagram, Resend) never go in a Wrangler file.
  "vars": {
    "CROWDFUNDING_IMPORT_ENABLED": "false",
    "GROWTHBOOK_API_HOST": "https://cdn.growthbook.io",
    "GROWTHBOOK_CLIENT_KEY": "",
    "RESEND_FROM": "Mesa Aberta <no-reply@example.invalid>",
    // A DSN only allows sending events, so it is not a secret. Blank, Sentry stays off.
    "SENTRY_DSN": "",
    "SUPABASE_URL": "",
    // "true" sweeps through the Postgres poller (ADR 0003). Off until the user says so.
    "EVENT_POLLER": "",
    // Handler names the queue consumer runs for real, comma-separated (ADR 0003, stage 3). Blank
    // keeps it in the shadow stage: every message is acknowledged and nothing runs.
    "QUEUE_LIVE_HANDLERS": "",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://mesaaberta:mesaaberta@localhost:5432/mesaaberta",
    },
  ],
  // The shadow consumer acknowledges and counts; it runs no handler (ADR 0003, stage 2). It does
  // nothing until this Worker is deployed. The consumer settles every message itself and caps
  // attempts at 8, so the queue's own limit is above that and the DLQ only gets what crashed.
  "queues": {
    "consumers": [
      {
        "queue": "domain-events-canary",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "domain-events-canary-dlq",
      },
    ],
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
  },
}
