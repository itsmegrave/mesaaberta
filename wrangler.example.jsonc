{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mesaaberta-local",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  // A single-Worker self-host example: one Worker serves the site and runs both crons, with no
  // separate background Worker. `wrangler.jsonc` is the default, which leaves the crons to apps/worker.
  "vars": {
    // Daily RPG campaign discovery at 01:00 America/Sao_Paulo (04:00 UTC).
    "CROWDFUNDING_IMPORT_ENABLED": "false",
    // "true": the cron sweeps events through the Postgres poller and the executor (ADR 0003).
    "EVENT_POLLER": "",
    // Footer links; leave empty to hide them.
    "CANNY_CHANGELOG_URL": "",
    "CANNY_FEEDBACK_URL": "",
    "APP_ORIGIN": "http://localhost:5173",
    "CALENDAR_UID_DOMAIN": "localhost",
    "CONTACT_EMAIL": "contact@example.invalid",
    "PRIVACY_CONTROLLER_NAME": "Responsável pela instância",
    "PRIVACY_EMAIL": "privacy@example.invalid",
    "RESEND_FROM": "Mesa Aberta <no-reply@example.invalid>",
    "MAILPIT_URL": "http://127.0.0.1:54344",
    "GROWTHBOOK_CLIENT_KEY": "",
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": "",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder for local emulation; replace with your own ID only if deploying to Cloudflare.
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://mesaaberta:mesaaberta@localhost:5432/mesaaberta",
    },
  ],
  "triggers": { "crons": ["*/5 * * * *", "0 4 * * *"] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": false,
  "preview_urls": false,
}
