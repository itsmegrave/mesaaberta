{
	"name": "mesaaberta",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync && pnpm run i18n && wrangler types || echo ''",
		"check": "wrangler types && pnpm run i18n && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "wrangler types && pnpm run i18n && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"gen": "wrangler types",
		"i18n": "node scripts/i18n.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@inlang/plugin-message-format": "^4.4.4",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.1",
		"@typescript/native": "npm:typescript@7",
		"@vitest/browser-playwright": "^5.0.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.97.0"
	},
	"packageManager": "pnpm@12.4.2",
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/cinzel": "^5.3.0",
		"@fontsource-variable/literata": "^5.3.0"
	}
}
