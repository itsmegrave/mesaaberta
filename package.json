{
  "name": "mesaaberta",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=26"
  },
  "scripts": {
    "dev": "cd apps/web && bun run --bun vite dev",
    "dev:up": "bun scripts/dev/up.ts",
    "dev:local": "bun scripts/dev/serve.ts",
    "build": "bun scripts/migrate-on-deploy.ts && bun run wrangler types && cd apps/web && bun run --bun vite build",
    "preview": "bun run wrangler dev apps/web/.svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "(cd apps/web && bun run --bun svelte-kit sync) && bun run i18n && bun run wrangler types || echo ''",
    "check": "bun run wrangler types && bun run i18n && cd apps/web && bun run --bun svelte-kit sync && bun run --bun svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "bun run wrangler types && bun run i18n && cd apps/web && bun run --bun svelte-kit sync && bun run --bun svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
    "lint": "bun run --bun prettier --check . && bun run --bun eslint .",
    "lint:fix": "bun run --bun prettier --write . && bun run --bun eslint . --fix",
    "format": "bun run --bun prettier --write .",
    "test:unit": "cd apps/web && bun run --bun vitest run --project client --project server",
    "test:integration": "cd apps/web && bun --env-file=../../.dev.vars ../../node_modules/vitest/vitest.mjs run --project integration",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit:watch": "cd apps/web && bun run --bun vitest",
    "test:e2e": "bun run playwright test -c apps/web/playwright.config.ts",
    "e2e:up": "supabase start -x realtime,imgproxy,studio,edge-runtime,logflare,vector,postgres-meta,supavisor && bun scripts/e2e-prepare.ts",
    "e2e:down": "supabase stop",
    "gen": "bun run wrangler types",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "bun run --bun drizzle-kit generate",
    "db:migrate": "bun --env-file=.dev.vars ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:make-admin": "bun --env-file=.dev.vars scripts/make-admin.ts",
    "calendar:sample": "bun scripts/sample-invite.ts",
    "resend:templates": "bun --env-file=.dev.vars scripts/create-resend-templates.ts",
    "db:seed": "bun --env-file=.dev.vars scripts/seed.ts",
    "i18n": "bun scripts/i18n.ts",
    "icons": "bun scripts/icons.ts",
    "crowdfunding:dry-run": "bun scripts/crowdfunding-import-dry-run.ts",
    "badges:backfill": "bun --env-file=.dev.vars scripts/badges-backfill.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@typescript/native": "npm:typescript@7",
    "@vitest/browser-playwright": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.117.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-svelte": "^3.1.0",
    "wrangler": "^4.137.0"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@cf-wasm/resvg": "^0.4.0",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@growthbook/growthbook": "^1.7.0",
    "@iconify-svelte/game-icons": "^1.0.3",
    "@iconify-svelte/reicon": "^1.0.3",
    "@iconify-svelte/simple-icons": "1.0.44",
    "@iconify-svelte/svg-spinners": "^1.0.2",
    "@mesaaberta/config": "workspace:*",
    "@mesaaberta/contracts": "workspace:*",
    "@mesaaberta/core": "workspace:*",
    "@mesaaberta/db": "workspace:*",
    "@mesaaberta/events": "workspace:*",
    "@mesaaberta/privy": "workspace:*",
    "@sentry/cloudflare": "11.1.0",
    "@sentry/core": "11.1.0",
    "@sentry/sveltekit": "^11.1.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/svelte-form": "^1.33.5",
    "@tanstack/svelte-query": "^6.3.0",
    "@tanstack/svelte-table": "^9.2.4",
    "@tiptap/core": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "aws4fetch": "^1.0.20",
    "cropperjs": "^2.2.0",
    "devalue": "^6.0.2",
    "drizzle-orm": "^0.45.3",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "ical.js": "^2.2.1",
    "jpeg-js": "^0.4.4",
    "linkifyjs": "^4.3.3",
    "marked": "^18.1.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "temporal-polyfill": "1.0.5",
    "timezones-ical-library": "^2.3.2",
    "xss": "^1.0.15",
    "xstate": "^5.33.2",
    "zod": "^4.6.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "workerd",
    "supabase"
  ],
  "overrides": {
    "undici@<7.30.1": "7.30.1",
    "devalue@<5.9.3": "5.9.4",
    "cookie@<0.7.0": "0.7.2",
    "esbuild@<0.25.0": "0.25.12",
    "sharp@<0.35.5": "0.35.5",
    "source-map-js@<1.2.2": "1.2.2"
  }
}
