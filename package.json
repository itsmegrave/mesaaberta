{
  "name": "mesaaberta",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/migrate-on-deploy.ts && wrangler types && vite build && node scripts/wrap-worker.ts",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync && pnpm run i18n && wrangler types || echo ''",
    "check": "wrangler types && pnpm run i18n && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "wrangler types && pnpm run i18n && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "format": "prettier --write .",
    "test:unit": "vitest run --project client --project server",
    "test:integration": "node --env-file-if-exists=.dev.vars ./node_modules/vitest/vitest.mjs run --project integration",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:up": "supabase start -x realtime,imgproxy,studio,edge-runtime,logflare,vector,postgres-meta,supavisor && node scripts/e2e-prepare.ts",
    "e2e:down": "supabase stop",
    "gen": "wrangler types",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.dev.vars ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:make-admin": "node --env-file-if-exists=.dev.vars scripts/make-admin.ts",
    "calendar:sample": "node scripts/sample-invite.ts",
    "resend:templates": "node --env-file-if-exists=.dev.vars scripts/create-resend-templates.ts",
    "db:seed": "node --env-file-if-exists=.dev.vars scripts/seed.ts",
    "i18n": "node scripts/i18n.ts",
    "icons": "node scripts/icons.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.137",
    "@iconify/svelte": "^5.2.2",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@inlang/paraglide-js": "^2.18.2",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@typescript/native": "npm:typescript@7",
    "@vitest/browser-playwright": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.117.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-svelte": "^3.1.0",
    "wrangler": "^4.137.0"
  },
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@cf-wasm/resvg": "^0.4.0",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@growthbook/growthbook": "^1.7.0",
    "@sentry/cloudflare": "11.1.0",
    "@sentry/sveltekit": "^11.1.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/svelte-form": "^1.33.5",
    "@tanstack/svelte-query": "^6.3.0",
    "@tanstack/svelte-table": "^9.2.4",
    "cropperjs": "^2.2.0",
    "devalue": "^6.0.2",
    "drizzle-orm": "^0.45.3",
    "ical.js": "^2.2.1",
    "jpeg-js": "^0.4.4",
    "linkifyjs": "^4.3.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "sveltekit-superforms": "^2.30.2",
    "temporal-polyfill": "1.0.5",
    "timezones-ical-library": "^2.3.2",
    "zod": "^4.6.5"
  }
}
